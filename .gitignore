# Secrets -- never commit your HF token or any local env overrides
.env

# Generated results -- these are run outputs, not source; regenerate via
# scripts/run.ps1 or docker compose, don't version them
outputs/*
!outputs/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker
*.log
