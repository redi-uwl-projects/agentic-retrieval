# A template .env file.
# docker compose run --rm agentic-retrieval
# Any value left unset falls back to the default baked into docker-compose.yml.

DATASET_SOURCE=bright
DATASET_NAME=psychology
SPLIT=test

CORPUS_SUBSET_SIZE=20000
MAX_QUERIES=100
TOP_K_RETRIEVE=100

LLM_NAME=Qwen/Qwen2.5-7B-Instruct
LLM_BACKEND=ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
DENSE_MODEL=multi-qa-MiniLM-L6-cos-v1
CROSS_ENCODER_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

MAX_REFINE=2
SEED=42
LOG_LEVEL=INFO

# Required for gated models on huggingface
HF_TOKEN=
